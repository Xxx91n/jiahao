{
  "description": "jiahao verifier discipline - ZCode plugin hook map",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${ZCODE_PLUGIN_ROOT}/hooks/jiahao-activate.js\" zcode",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${ZCODE_PLUGIN_ROOT}/hooks/jiahao-mode-tracker.js\" zcode",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${ZCODE_PLUGIN_ROOT}/hooks/jiahao-verdict-gate.js\" zcode",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${ZCODE_PLUGIN_ROOT}/hooks/jiahao-pretool-guard.js\" zcode",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
