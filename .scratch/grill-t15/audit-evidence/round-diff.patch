+    "R1": {
+      "name": "runtime",
+      "rule": "files in the static require() closure of seeds.runtime_closure_roots (scripts/surface-taxonomy.js computeRuntimeClosure); enumerated snapshot below - drift between this list and a fresh scan fails the wiring test",
