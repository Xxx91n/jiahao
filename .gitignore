# Dependencies
node_modules/

# Build output
dist/

# Agent runtimes / scratch spaces
.omx/
.codex-tmp/
.codegraph/

# .scratch/ is git-tracked since 2026-09-15 (issue tracker + round records);
# only volatile tool workdirs stay ignored:
.scratch/pack-smoke/
.scratch/g6-publish/
.scratch/.tmp-*

# Examiner work product: never-commit nc-001 mechanized at the channel level
# (grill-t36 D-008). Covers the audit-evidence / audit2-evidence /
# audit3-evidence family plus the same-stage audit-backup residue. Already
# tracked files are unaffected (an ignore rule is inert on a tracked path),
# so the LEGACY instances in test/adr-0083-wiring.test.js stay readable.
.scratch/*/audit*-evidence/
.scratch/*/audit-backup/

# Logs
*.log

# OS / shell noise
nul
Thumbs.db
.DS_Store

# IDE / editor
.vscode/
.idea/
*.swp
*.swo

# Secrets (ADR-0014 convention)
private/

# Project-local gate artifacts (ADR-0027 D4 isomorphic evidence)
bench-artifacts/
probe-artifacts/
test-artifacts/
mr-artifacts/
__pycache__/

# Derived pack artifacts are never committed (grill-t11 audit F-A1, ADR-0073 D-C)
/*.tgz

# Host configuration backups never enter git-tracked dirs (ADR-0073 D-C O-2 forward rule)
host-config-backup/
