{
  "name": "jiahao",
  "version": "0.0.1",
  "description": "Prompt-as-mental-model skill distribution for second-party agents",
  "license": "MIT",
  "scripts": {
    "test": "jest --verbose",
    "bench:gate": "node scripts/check-bench-thresholds.js && node scripts/bench-gate.js",
    "prepare": "git config core.hooksPath .githooks || true",
    "probes:gate": "node bench/polygraph/check-probe-corpus.js && node scripts/check-probes.js",
    "reverify": "node scripts/reverify.js",
    "judge:bias": "node bench/polygraph/check-judge-bias.js",
    "coverage:gate": "node scripts/check-coverage.js",
    "deferred:gate": "node scripts/check-deferred.js",
    "gate:all": "node scripts/run-gates.js",
    "adr:gate": "node scripts/build-adr-index.js --check",
    "instrument:gate": "node scripts/instrument.js --check",
    "mr:gate": "node scripts/check-mr-probes.js"
  },
  "devDependencies": {
    "jest": "^29.7.0"
  },
  "dependencies": {
    "http-link-header": "^1.1.4",
    "prompts": "^2.4.2"
  },
  "bin": {
    "jiahao": "scripts/install.js"
  },
  "files": [
    "src/",
    "scripts/",
    "adapters/",
    "schemas/",
    "hooks/",
    "jiahao-mcp/",
    "docs/gates.json",
    "docs/coverage-map.json",
    "docs/deferred-registry.json",
    "bench/polygraph/thresholds.json",
    "CONTEXT.md",
    "README.md",
    "AGENTS.md"
  ]
}
